{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "types": [
      "node"
    ],
    "paths": {
      "@moneymart/tokens": [
        "../../packages/tokens/src/index.ts"
      ],
      "@moneymart/types": [
        "../../packages/types/src/index.ts"
      ]
    },
    "noEmit": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
