registry=https://registry.npmjs.org/
store-dir=.pnpm-store
strict-peer-dependencies=false
auto-install-peers=true
resolution-mode=highest

# Hoisted layout: Next.js resolves its optional platform/SWC binaries relative to
# its own package directory, which an isolated (symlinked) layout breaks. A flat
# node_modules also keeps Metro/Expo resolution predictable for the mobile app.
node-linker=isolated
