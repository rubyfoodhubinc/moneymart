# ── MoneyMart environment ────────────────────────────────────────────────
# Replace the dev-API URL at build time for a real deployment, e.g.
#   VITE_API_URL=https://api.moneymart.example pnpm build:web

# Web client (Vite). Only VITE_-prefixed variables are exposed to the browser.
# Per-environment defaults live in apps/web/.env and apps/web/.env.production.
VITE_API_URL=http://127.0.0.1:4317

# API service
PORT=4317
NODE_ENV=development
# Set MM_SEED=false to boot an empty database instead of the demo auction house.
MM_SEED=true

# Registries (offline-friendly defaults)
NPM_CONFIG_REGISTRY=https://registry.npmjs.org/
