# ═══════════════════════════════════════════════════════════════════════════
# MoneyMart — environment contract
#
# Copy to .env for local work. In production these are set in the hosting
# platform: Railway for the API, Vercel for the web app. Never commit real
# values — this file documents the contract only.
#
# Every integration below is optional and DEGRADES HONESTLY: with no key the
# API reports the provider as unconfigured and the client falls back to the
# simulated rail, rather than silently failing a payment.
# ═══════════════════════════════════════════════════════════════════════════

# ── Core ───────────────────────────────────────────────────────────────────
# Railway injects PORT. 4317 matches local development.
PORT=4317
NODE_ENV=development
# false boots an empty platform instead of the demo auction house.
MM_SEED=true

# Static hosting from the API origin (the unified deployment).
# MM_WEB_DIR=./apps/web/dist
# MM_TV_DIR=./apps/tv/dist

# TLS. Railway terminates TLS at its edge; only set these when terminating
# locally (see scripts/make-cert.mjs).
# MM_TLS_CERT=./.certs/server.crt
# MM_TLS_KEY=./.certs/server.key

# ── Authentication ─────────────────────────────────────────────────────────
# Passwordless one-time codes. Codes are hashed before storage and single-use.
#
# Exposing the code in the API response lets a developer or an automated test
# complete a sign-in without a mail or SMS account. Defaults to ON outside
# production and OFF in production; set explicitly to override.
# MM_AUTH_DEV_CODES=false
#
# Server-side pepper for code hashing. Set a long random value in production so a
# database read alone cannot be used to brute-force a live code.
MM_AUTH_PEPPER=
# From address for code emails.
MM_AUTH_FROM=MoneyMart <no-reply@moneymart.app>
#
# The `x-mm-user` demo header selects any account without verification, so it is
# an authentication bypass. It is allowed outside production and refused in
# production unless explicitly enabled here.
# MM_ALLOW_DEMO_AUTH=false

# ── Web client (Vite) ──────────────────────────────────────────────────────
# Only VITE_-prefixed variables reach the browser.
#   EMPTY  → resolve the gateway from the page origin (single-origin deploy)
#   SET    → call that absolute API origin (Vercel web + Railway api)
# VITE_API_URL=https://moneymart-api.up.railway.app

# ═══════════════════════════════════════════════════════════════════════════
# Payment rails (§9.1)
# ═══════════════════════════════════════════════════════════════════════════

# Stripe — cards, USD/GBP/CAD. Activates on a secret key beginning sk_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal — activates on a client id and secret pair.
# Sandbox: https://api-m.sandbox.paypal.com   Live: https://api-m.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Paystack — NGN cards, bank transfer and USSD.
PAYSTACK_SECRET_KEY=

# Flutterwave — pan-African cards and mobile money.
FLUTTERWAVE_SECRET_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# Subscriptions and entitlements (RevenueCat)
# ═══════════════════════════════════════════════════════════════════════════
# Server-side API key for receipt validation and the Pro entitlement.
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_SECRET=
# Public SDK keys, exposed to the clients.
REVENUECAT_PUBLIC_IOS_KEY=
REVENUECAT_PUBLIC_ANDROID_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# Live video (HLS)
# ═══════════════════════════════════════════════════════════════════════════
# Mux — managed HLS ingest and playback. Without it the stream room plays a
# public demo HLS manifest so the player path is still exercised, and the API
# labels the source 'demo' so it is never mistaken for a live broadcast.
# MM_DEMO_HLS_URL overrides the demo manifest used for live rooms.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
# Cloudflare Stream — alternative ingest.
CLOUDFLARE_STREAM_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ═══════════════════════════════════════════════════════════════════════════
# Data (Supabase / Postgres)
# ═══════════════════════════════════════════════════════════════════════════
# The API ships with an in-memory store that mirrors Redis ordering semantics.
# Setting DATABASE_URL switches persistence on.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# Supporting services
# ═══════════════════════════════════════════════════════════════════════════
# ── SMS sign-in (Twilio) ───────────────────────────────────────────────────
# The Messages API, NOT Verify.
#
# Twilio's Verify product generates its own code and ignores any supplied one, so
# it cannot be paired with the locally generated code this platform verifies: the
# user would receive Twilio's digits while the server compared against the hash of
# its own, and every SMS sign-in would be rejected as invalid. The Messages API
# sends the exact body it is given, which is what makes the flow work.
#
# A sender is REQUIRED — supply either a Messaging Service SID (preferred in
# production, so senders can be swapped without a deploy) or a from-number.
# Without one, SMS is reported as unconfigured rather than silently failing.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# ── Email sign-in (Resend) ─────────────────────────────────────────────────
# Activates on the API key alone. RESEND_FROM defaults to
# `MoneyMart <onboarding@resend.dev>`, which works without a verified domain so a
# first sign-in is possible before DNS is done; set a branded address once the
# domain is verified in Resend.
RESEND_API_KEY=
RESEND_FROM=

AVALARA_ACCOUNT_ID=
AVALARA_LICENSE_KEY=

SENTRY_DSN=

# ═══════════════════════════════════════════════════════════════════════════
# Social sign-in (Google / Apple) — §9.1
# ═══════════════════════════════════════════════════════════════════════════
# Each provider activates independently: a provider with no credentials is
# reported as unconfigured and its button is not offered, rather than presented
# as a dead end. /api/auth/health and /api/auth/oauth/providers report the state.

# Google — create an OAuth 2.0 Web client in Google Cloud Console.
# Authorised redirect URI: https://<your-api-host>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple — a Services ID plus a Sign in with Apple key (.p8).
# Authorised redirect URI: https://<your-api-host>/api/auth/oauth/apple/callback
#
# APPLE_CLIENT_ID is the Services ID (not the app bundle id).
# APPLE_PRIVATE_KEY accepts either the PEM text with newlines escaped as \n —
# which is how a hosting dashboard stores it — or a path to the .p8 file.
# Apple has no static client secret: the server mints a short-lived ES256 JWT
# from these four values on every exchange, as Apple requires.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# The app's own origin, when it differs from the gateway's.
# The web build is served from a different host than the API on Vercel, and the
# sign-in handoff must return the browser to the APP. Without this the token is
# handed to the API origin, which serves no app. Leave empty for the unified
# deployment, where both share an origin.
MM_OAUTH_APP_ORIGIN=

# ═══════════════════════════════════════════════════════════════════════════
# Registries
# ═══════════════════════════════════════════════════════════════════════════
NPM_CONFIG_REGISTRY=https://registry.npmjs.org/
